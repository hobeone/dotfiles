#!/bin/bash
#
# update-deps
# Updates Go and bun dependencies of a Go repo with a bun frontend, then
# verifies the result. Run it from anywhere inside the repo.
#
# Usage: update-deps [--latest] [--skip-verify] [--commit] [--yes]
#   --latest       also cross major versions for bun (rewrites package.json);
#                  packages in BUN_LATEST_EXCLUDES are skipped
#   --skip-verify  skip the build/test checks after updating (they are also
#                  skipped when the update changed no dependency file)
#   --commit       commit the dependency files with a summary of what changed;
#                  shows the message and asks for confirmation first
#   --yes          with --commit, skip the confirmation prompt (also skipped
#                  when stdin is not a terminal)
#
# The frontend is the one top-level directory holding a bun.lock (ui/,
# frontend/, ...). Set UPDATE_DEPS_UI_DIR to choose it when there are several.
# If the frontend depends on @sveltejs/kit, svelte-kit sync runs after each
# bun prune.
#

set -euo pipefail

MAX_LINES=40

# Packages that --latest must not bump, as bun negation patterns.
# typescript: svelte-check only supports TypeScript 5 and 6 (7 is the native
# port without the JS compiler API). Drop this once svelte-check supports 7.
BUN_LATEST_EXCLUDES=('!typescript')

# Set by configure.
UI_DIR=""
DEP_FILES=()
DIFF_FILES=()

# run <cmd...>: prints the command, then runs it.
run() {
  printf '+ %s\n' "$*"
  "$@"
}

# run_in <dir> <cmd...>: like run, but executes the command inside <dir>.
run_in() {
  local dir="$1"
  shift
  printf '+ (cd %s && %s)\n' "${dir}" "$*"
  (cd "${dir}" && "$@")
}

# detect_ui_dir: prints the frontend directory, relative to the current
# directory: UPDATE_DEPS_UI_DIR if set, else the one top-level directory that
# holds a bun.lock. Fails when there is none or more than one.
detect_ui_dir() {
  if [[ -n "${UPDATE_DEPS_UI_DIR:-}" ]]; then
    if [[ ! -f "${UPDATE_DEPS_UI_DIR}/bun.lock" ]]; then
      echo "update-deps: UPDATE_DEPS_UI_DIR=${UPDATE_DEPS_UI_DIR} has no bun.lock" >&2
      return 1
    fi
    printf '%s\n' "${UPDATE_DEPS_UI_DIR%/}"
    return 0
  fi

  local lock dirs=()
  for lock in */bun.lock; do
    [[ -f "${lock}" ]] && dirs+=("${lock%/bun.lock}")
  done
  case "${#dirs[@]}" in
    1) printf '%s\n' "${dirs[0]}" ;;
    0)
      echo "update-deps: no top-level directory holds a bun.lock" >&2
      return 1
      ;;
    *)
      echo "update-deps: several frontends (${dirs[*]}); set UPDATE_DEPS_UI_DIR" >&2
      return 1
      ;;
  esac
}

# uses_sveltekit <dir>: succeeds when <dir>/package.json depends on @sveltejs/kit.
uses_sveltekit() {
  grep -q '"@sveltejs/kit"' "$1/package.json"
}

# configure: finds the frontend and sets UI_DIR, DEP_FILES and DIFF_FILES.
configure() {
  UI_DIR="$(detect_ui_dir)"
  DEP_FILES=(go.mod go.sum "${UI_DIR}/package.json" "${UI_DIR}/bun.lock")
  DIFF_FILES=(go.mod "${UI_DIR}/package.json" "${UI_DIR}/bun.lock")
}

# prune_ui: drops unused packages. For SvelteKit it then regenerates
# node_modules/$app: SvelteKit 3 writes $app there (tsconfig.json extends
# $app/tsconfig), and bun prune removes it as an undeclared package, which
# breaks type-checking until the next sync.
prune_ui() {
  run_in "${UI_DIR}" bun prune
  if uses_sveltekit "${UI_DIR}"; then
    run_in "${UI_DIR}" bun x svelte-kit sync
  fi
}

# dep_snapshot: prints checksums of the dependency files as they are now, so
# comparing two snapshots tells whether anything changed in between. Edits
# made before the run don't count, unlike with git diff.
dep_snapshot() {
  cksum "${DEP_FILES[@]}" 2>/dev/null || true
}

# summarize_changes <mode> <file>
# Reads the uncommitted diff of <file> and prints one line per dependency that
# was bumped, added or removed. <mode> is "go" (go.mod) or "bun" (bun.lock).
summarize_changes() {
  local mode="$1" file="$2"
  git diff -U0 -- "${file}" | awk -v mode="${mode}" '
    function parse(line,    f, m) {
      name = ""; ver = ""
      if (mode == "go") {
        split(line, f, /[ \t]+/)
        # f[1] is empty (leading tab), f[2]=module, f[3]=version
        if (f[2] != "" && f[3] ~ /^v[0-9]/) { name = f[2]; ver = f[3] }
      } else if (match(line, /"[^"]+": \["[^"]+@[^"]+"/)) {
        m = substr(line, RSTART, RLENGTH)
        sub(/^"/, "", m); name = m; sub(/".*/, "", name)
        ver = m; sub(/.*@/, "", ver); sub(/"$/, "", ver)
      }
    }
    /^---|^\+\+\+/ { next }
    /^-/ { parse(substr($0, 2)); if (name != "") old[name] = ver }
    /^\+/ { parse(substr($0, 2)); if (name != "") new[name] = ver }
    END {
      for (n in new) {
        if (!(n in old)) printf "- %s %s (added)\n", n, new[n]
        else if (old[n] != new[n]) printf "- %s %s -> %s\n", n, old[n], new[n]
      }
      for (n in old) if (!(n in new)) printf "- %s %s (removed)\n", n, old[n]
    }' | sort
}

# section <title> <summary>: prints a titled, length-capped list (or nothing).
section() {
  local title="$1" summary="$2" total
  [[ -z "${summary}" ]] && return 0
  total="$(wc -l <<<"${summary}")"
  printf '%s (%d):\n' "${title}" "${total}"
  head -n "${MAX_LINES}" <<<"${summary}"
  if ((total > MAX_LINES)); then
    printf -- '- ... and %d more\n' "$((total - MAX_LINES))"
  fi
  printf '\n'
}

# build_commit_message <verification: verified|skip-flag|unchanged>
build_commit_message() {
  local verification="$1" go_summary bun_summary
  go_summary="$(summarize_changes go go.mod)"
  bun_summary="$(summarize_changes bun "${UI_DIR}/bun.lock")"

  printf 'chore(deps): update go and bun dependencies\n\n'
  section "Go modules" "${go_summary}"
  section "Bun packages" "${bun_summary}"
  case "${verification}" in
    verified)
      printf 'Verified with go build, go test, bun run check, bun run build and bun run test.\n'
      ;;
    skip-flag) printf 'Not verified: update ran with --skip-verify.\n' ;;
    unchanged) printf 'Not verified: the update itself changed no dependency file.\n' ;;
  esac
}

main() {
  local latest=0 verify=1 commit=0 yes=0 arg root before verification
  for arg in "$@"; do
    case "${arg}" in
      --latest) latest=1 ;;
      --skip-verify) verify=0 ;;
      --commit) commit=1 ;;
      --yes) yes=1 ;;
      -h|--help) sed -n '2,$ { /^#/!q; s/^# \{0,1\}//; p }' "${BASH_SOURCE[0]}"; exit 0 ;;
      *) echo "Unknown argument: ${arg}" >&2; exit 2 ;;
    esac
  done

  if ! root="$(git rev-parse --show-toplevel 2>/dev/null)"; then
    echo "update-deps: not inside a git repository" >&2
    exit 1
  fi
  cd "${root}"
  if [[ ! -f go.mod ]]; then
    echo "update-deps: no go.mod in ${root}" >&2
    exit 1
  fi
  configure
  before="$(dep_snapshot)"

  echo "=== [1/4] Updating Go modules ==="
  run go get -u -v -t ./...
  run go mod tidy

  echo "=== [2/4] Updating bun packages ==="
  if [[ "${latest}" -eq 1 ]]; then
    run_in "${UI_DIR}" bun update --latest "${BUN_LATEST_EXCLUDES[@]}"
  else
    run_in "${UI_DIR}" bun update
  fi
  prune_ui

  if [[ "${verify}" -eq 0 ]]; then
    verification=skip-flag
    echo "=== Skipping verification (--skip-verify) ==="
  elif [[ "$(dep_snapshot)" == "${before}" ]]; then
    verification=unchanged
    echo "=== Skipping verification: no dependency file changed ==="
  else
    verification=verified
    # The frontend goes first: its build output is what the Go code embeds,
    # so go build fails in a fresh clone without it, and go test would
    # otherwise run against a stale build.
    echo "=== [3/4] Verifying ${UI_DIR} ==="
    # Install exactly what bun.lock records, so the checks below run against
    # the locked versions; it also fails if bun.lock and package.json disagree.
    run_in "${UI_DIR}" bun install --frozen-lockfile
    prune_ui
    run_in "${UI_DIR}" bun run check
    run_in "${UI_DIR}" bun run build
    run_in "${UI_DIR}" bun run test

    echo "=== [4/4] Verifying Go ==="
    run go build ./...
    run go test ./...
  fi

  if [[ "${commit}" -eq 1 ]]; then
    echo "=== Committing ==="
    if git diff --quiet -- "${DEP_FILES[@]}"; then
      echo "No dependency changes to commit."
    else
      local msg reply
      msg="$(mktemp)"
      # Expand now: `msg` is local and out of scope when the EXIT trap fires.
      # shellcheck disable=SC2064
      trap "rm -f '${msg}'" EXIT
      build_commit_message "${verification}" >"${msg}"

      echo
      git --no-pager diff --stat -- "${DEP_FILES[@]}"
      echo
      echo "Dependency diff (go.sum omitted; it only holds checksums):"
      git --no-pager diff -U0 -- "${DIFF_FILES[@]}"
      echo
      echo "Commit message:"
      echo "----------------------------------------"
      cat "${msg}"
      echo "----------------------------------------"

      if [[ "${yes}" -eq 0 && -t 0 ]]; then
        read -r -p "Commit these changes? [y/N] " reply
        if [[ ! "${reply}" =~ ^[Yy]$ ]]; then
          echo "Not committed. Changes are left in the working tree."
          echo "Review with: git diff -- ${DEP_FILES[*]}"
          exit 0
        fi
      fi

      # Only the dependency files are committed; other staged or modified
      # files are left untouched.
      run git add -- "${DEP_FILES[@]}"
      run git commit -F "${msg}" -- "${DEP_FILES[@]}"
    fi
  else
    echo
    echo "Done. Review changes with: git diff --stat ${DEP_FILES[*]}"
  fi
}

# Run only when executed directly, so the helpers can be sourced for testing.
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  main "$@"
fi
