#!/bin/bash
#
# agent-memory
# Two-tier memory shared by coding agents (Claude Code, agy) across
# projects and machines. The store is a git repo:
#
#   $AGENT_MEMORY_HOME/global/              applies to every project
#   $AGENT_MEMORY_HOME/projects/<key>/      one project, every checkout of it
#
# <key> is the origin remote's owner/repo (hobeone/gonzbd), so every
# checkout of a repo shares one folder on every machine. A repo with no
# origin, or a directory outside git, gets local/<folder name>.
#
# Usage: agent-memory <command> [dir]
#   key [dir]     print the project key for dir (default: current directory)
#   paths [dir]   print "global: <path>" and "project: <path>", creating the
#                 project folder if it is missing
#   link [dir]    point Claude Code's memory folder for dir's project at the
#                 project folder; refuses to replace a folder holding files
#   index         regenerate every MEMORY.md from its folder's front matter
#   check [dir]   report memory files in the global tier and dir's project
#                 with broken front matter; exits 1 when there are any
#   context [dir] print both indexes, the folders and any problems: what an
#                 agent needs at the start of a session
#   sync [--if-needed]
#                 index, commit, pull --rebase and push the store; with
#                 --if-needed, do nothing unless there is something to commit
#                 or push
#   hook <claude|agy> <start|stop>
#                 the session hooks: read the hook's JSON on stdin, sync, and
#                 wire up or report memory. Never fails the session.
#
# Environment:
#   AGENT_MEMORY_HOME     the store (default ~/.agents/memory)
#   CLAUDE_PROJECTS_DIR   Claude Code's per-project folders
#                         (default ~/.claude/projects)
#
# MEMORY.md is derived from the memory files' front matter, so the store's
# .gitignore excludes it and every machine regenerates its own: it never
# conflicts and never drifts from the files it lists.
#

set -euo pipefail

STORE="${AGENT_MEMORY_HOME:-${HOME}/.agents/memory}"
CLAUDE_PROJECTS="${CLAUDE_PROJECTS_DIR:-${HOME}/.claude/projects}"

# The index being written, removed on any exit so a failed run leaves no
# stray file for sync to commit.
INDEX_TMP=""
trap '[[ -n "${INDEX_TMP}" ]] && rm -f "${INDEX_TMP}"' EXIT

die() {
  echo "agent-memory: $*" >&2
  exit 1
}

# safe_component <s>: succeeds when <s> can be one path component of a key.
# Keys become paths under the store, so nothing may climb out of it.
safe_component() {
  [[ "$1" =~ ^[A-Za-z0-9._-]+$ && "$1" != "." && "$1" != ".." && "$1" != ".git" ]]
}

# main_worktree <dir>: prints the top of the main worktree holding <dir>, so
# a linked worktree resolves to the checkout it belongs to. Fails outside git.
main_worktree() {
  local common
  common="$(git -C "$1" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" || return 1
  if [[ "$(basename "${common}")" == ".git" ]]; then
    dirname "${common}"
  else
    git -C "$1" rev-parse --show-toplevel 2>/dev/null
  fi
}

# key_from_url <url>: prints owner/repo from a git remote URL in scp
# (git@host:o/r.git), URL (https://host/o/r, ssh://git@host:22/o/r.git) or
# path form: the last two components, without .git, lowercased because
# GitHub owner and repo names are case-insensitive. The host is dropped, so
# the same owner/repo on two hosts shares a folder.
key_from_url() {
  local url="$1" owner repo
  url="${url%/}"
  url="${url%.git}"
  url="$(sed -E 's#[:/]+#/#g' <<<"${url}")"
  repo="${url##*/}"
  url="${url%/*}"
  owner="${url##*/}"
  if [[ "${owner}" == "${url}" ]] || ! safe_component "${owner}" || ! safe_component "${repo}"; then
    return 1
  fi
  printf '%s/%s\n' "${owner}" "${repo}" | tr '[:upper:]' '[:lower:]'
}

# project_key <dir>: prints the project key for <dir>.
project_key() {
  local dir="$1" top url name
  if top="$(main_worktree "${dir}")" && url="$(git -C "${top}" remote get-url origin 2>/dev/null)"; then
    key_from_url "${url}" || die "cannot derive owner/repo from origin '${url}'"
    return 0
  fi
  name="$(basename "${top:-$(cd "${dir}" && pwd -P)}")"
  name="$(sed -E 's/[^A-Za-z0-9._-]/-/g' <<<"${name}" | tr '[:upper:]' '[:lower:]')"
  safe_component "${name}" || die "cannot derive a project key from '${dir}'"
  printf 'local/%s\n' "${name}"
}

# claude_project_dir <dir>: prints Claude Code's per-project folder for the
# project holding <dir>: its absolute path with every character other than
# a letter or digit replaced by '-'.
claude_project_dir() {
  local top
  top="$(main_worktree "$1" || (cd "$1" && pwd -P))"
  printf '%s/%s\n' "${CLAUDE_PROJECTS}" "$(sed -E 's/[^A-Za-z0-9]/-/g' <<<"${top}")"
}

# front_matter_field <file> <field>: prints a top-level field from the YAML
# front matter at the start of <file>, without surrounding quotes.
front_matter_field() {
  awk -v field="$2" '
    NR == 1 { if ($0 != "---") exit; next }
    $0 == "---" { exit }
    index($0, field ":") == 1 {
      v = substr($0, length(field) + 2)
      sub(/^[ \t]+/, "", v); sub(/[ \t]+$/, "", v)
      if (v ~ /^".*"$/ || v ~ /^'\''.*'\''$/) v = substr(v, 2, length(v) - 2)
      print v
      exit
    }' "$1"
}

# index_dir <dir>: rewrites <dir>/MEMORY.md, one line per memory file,
# sorted by file name.
index_dir() {
  local dir="$1" f name desc
  INDEX_TMP="$(mktemp "${dir}/.MEMORY.md.XXXXXX")"
  {
    printf '# Memory index\n\n'
    printf '<!-- Generated by agent-memory from each file'\''s front matter. Edit the files, not this index. -->\n\n'
    for f in "${dir}"/*.md; do
      [[ -f "${f}" ]] || continue
      case "$(basename "${f}")" in MEMORY.md | README.md) continue ;; esac
      name="$(front_matter_field "${f}" name)"
      desc="$(front_matter_field "${f}" description)"
      [[ -n "${name}" ]] || name="$(basename "${f}" .md)"
      if [[ -n "${desc}" ]]; then
        printf -- '- [%s](%s) — %s\n' "${name}" "$(basename "${f}")" "${desc}"
      else
        printf -- '- [%s](%s)\n' "${name}" "$(basename "${f}")"
      fi
    done
  } >"${INDEX_TMP}"
  mv -f "${INDEX_TMP}" "${dir}/MEMORY.md"
  INDEX_TMP=""
}

# index_all: regenerates the global index and every project's.
index_all() {
  local d
  mkdir -p "${STORE}/global"
  index_dir "${STORE}/global"
  [[ -d "${STORE}/projects" ]] || return 0
  while IFS= read -r d; do
    index_dir "${d}"
  done < <(find "${STORE}/projects" -mindepth 2 -maxdepth 2 -type d | sort)
}

# check_dir <dir> <label>: prints "<label>/<file>: <problem>" for each
# memory file in <dir> whose front matter the index cannot use.
check_dir() {
  local dir="$1" label="$2" f base name
  for f in "${dir}"/*.md; do
    [[ -f "${f}" ]] || continue
    base="$(basename "${f}" .md)"
    case "${base}" in MEMORY | README) continue ;; esac
    if [[ "$(head -n 1 "${f}")" != "---" ]]; then
      printf '%s/%s.md: no front matter\n' "${label}" "${base}"
      continue
    fi
    name="$(front_matter_field "${f}" name)"
    [[ -n "${name}" ]] || printf '%s/%s.md: front matter has no name\n' "${label}" "${base}"
    [[ -n "$(front_matter_field "${f}" description)" ]] ||
      printf '%s/%s.md: front matter has no description\n' "${label}" "${base}"
    if [[ -n "${name}" && "${name}" != "${base}" ]]; then
      printf '%s/%s.md: name '\''%s'\'' does not match the file name\n' "${label}" "${base}" "${name}"
    fi
    if [[ "${label}" != global && -f "${STORE}/global/${base}.md" ]]; then
      printf '%s/%s.md: global/%s.md has the same name\n' "${label}" "${base}" "${base}"
    fi
  done
}

cmd_check() {
  local key problems
  key="$(project_key "${1:-.}")"
  problems="$(check_dir "${STORE}/global" global; check_dir "${STORE}/projects/${key}" "projects/${key}")"
  [[ -z "${problems}" ]] && return 0
  printf '%s\n' "${problems}"
  return 1
}

# index_lines <dir>: prints the entries of <dir>'s index, or a placeholder.
index_lines() {
  if [[ -f "$1/MEMORY.md" ]] && grep -q '^- ' "$1/MEMORY.md"; then
    grep '^- ' "$1/MEMORY.md"
  else
    echo "(no memories yet)"
  fi
}

cmd_context() {
  local dir="${1:-.}" key global project problems
  key="$(project_key "${dir}")"
  global="${STORE}/global"
  project="${STORE}/projects/${key}"
  mkdir -p "${global}" "${project}"
  index_dir "${global}"
  index_dir "${project}"
  printf '# Shared agent memory\n\n'
  printf 'Memories saved by earlier sessions, shared with other agents and machines.\n'
  printf 'Open a file when its line bears on the task. Read %s/README.md before saving one.\n\n' "${STORE}"
  printf '## Global: %s\n\n' "${global}"
  index_lines "${global}"
  printf '\n## Project %s: %s\n\n' "${key}" "${project}"
  index_lines "${project}"
  if ! problems="$(cmd_check "${dir}")"; then
    printf '\n## Memory files to fix\n\n%s\n' "${problems}"
  fi
}

cmd_key() {
  project_key "${1:-.}"
}

cmd_paths() {
  local key
  key="$(project_key "${1:-.}")"
  mkdir -p "${STORE}/global" "${STORE}/projects/${key}"
  printf 'global: %s/global\n' "${STORE}"
  printf 'project: %s/projects/%s\n' "${STORE}" "${key}"
}

cmd_link() {
  local dir="${1:-.}" key target cdir mem
  key="$(project_key "${dir}")"
  target="${STORE}/projects/${key}"
  mkdir -p "${target}"
  cdir="$(claude_project_dir "${dir}")"
  mem="${cdir}/memory"
  mkdir -p "${cdir}"

  if [[ -L "${mem}" ]]; then
    if [[ "$(readlink -f "${mem}")" == "$(readlink -f "${target}")" ]]; then
      return 0
    fi
    rm -f "${mem}"
  elif [[ -d "${mem}" ]]; then
    if [[ -n "$(find "${mem}" -mindepth 1 -maxdepth 1 ! -name MEMORY.md -print -quit)" ]] ||
      [[ -s "${mem}/MEMORY.md" ]]; then
      die "${mem} holds memories; move them into ${target} first"
    fi
    rm -f "${mem}/MEMORY.md"
    rmdir "${mem}"
  elif [[ -e "${mem}" ]]; then
    die "${mem} exists and is not a folder or a link"
  fi
  ln -s "${target}" "${mem}"
}

cmd_index() {
  index_all
}

# ensure_gitignore: the generated indexes and their temp files stay out of
# the store's history, so they never conflict between machines.
ensure_gitignore() {
  local pattern
  for pattern in 'MEMORY.md' '.MEMORY.md.*'; do
    grep -qxF -- "${pattern}" .gitignore 2>/dev/null || printf '%s\n' "${pattern}" >>.gitignore
  done
}

# commit_all: commits every change in the store, if there is one.
commit_all() {
  git add -A
  if ! git diff --cached --quiet; then
    git commit -q -m "chore: sync memory from $(hostname -s 2>/dev/null || hostname)"
  fi
}

# needs_sync: succeeds when the store has something to commit or push.
needs_sync() {
  [[ -n "$(git status --porcelain)" ]] && return 0
  git remote get-url origin >/dev/null 2>&1 || return 1
  local ahead
  if ahead="$(git rev-list --count '@{u}..HEAD' 2>/dev/null)"; then
    [[ "${ahead}" -gt 0 ]]
  else
    git rev-parse -q --verify HEAD >/dev/null
  fi
}

cmd_sync() {
  local if_needed=0 branch
  [[ "${1:-}" == "--if-needed" ]] && if_needed=1
  [[ -d "${STORE}/.git" ]] || die "${STORE} is not a git repository"
  cd "${STORE}"
  # Claude and agy can finish a turn at the same moment: the second sync
  # waits for the first rather than skipping, so it carries whatever the
  # first missed.
  if command -v flock >/dev/null 2>&1; then
    exec 9>"${STORE}/.git/agent-memory.lock"
    flock -w 20 9 || die "another sync held the lock for 20s"
  fi
  # A run killed mid-rebase leaves it in progress; only sync rebases here.
  if [[ -d .git/rebase-merge || -d .git/rebase-apply ]]; then
    git rebase --abort
  fi
  # Hooks run sync unattended: never wait for credentials, and give up on
  # a stalled transfer instead of holding up the session.
  export GIT_TERMINAL_PROMPT=0
  export GIT_SSH_COMMAND="${GIT_SSH_COMMAND:-ssh -o BatchMode=yes -o ConnectTimeout=10}"
  local net=(-c http.lowSpeedLimit=1000 -c http.lowSpeedTime=10)

  ensure_gitignore
  index_all
  if [[ "${if_needed}" -eq 1 ]] && ! needs_sync; then
    return 0
  fi
  commit_all
  git remote get-url origin >/dev/null 2>&1 || return 0
  branch="$(git symbolic-ref -q --short HEAD)" || die "${STORE} has a detached HEAD; check out a branch"

  # An agent may write between the commit and the pull, and pull --rebase
  # refuses a dirty tree. Commit once more; if files are still changing,
  # leave them for the next run rather than fail.
  commit_all
  if [[ -n "$(git status --porcelain)" ]]; then
    echo "agent-memory: files changed during sync; they go out with the next run"
    return 0
  fi

  # An empty remote (a newly created repo) has no branch to pull yet.
  if git "${net[@]}" ls-remote --exit-code --heads origin "${branch}" >/dev/null 2>&1; then
    if ! git "${net[@]}" pull -q --rebase origin "${branch}"; then
      if [[ -d .git/rebase-merge || -d .git/rebase-apply ]]; then
        git rebase --abort
        die "pull --rebase conflicted; local commits are kept, resolve by hand in ${STORE}"
      fi
      die "pull from origin failed; local commits are kept"
    fi
  fi
  git "${net[@]}" push -q -u origin "${branch}"
  index_all
}

# hook_cwd <json>: prints the session's working directory from a hook's
# input. Both Claude Code and agy send it as "cwd"; agy runs the hook from
# its config folder, so $PWD is no substitute there.
hook_cwd() {
  local cwd=""
  if command -v jq >/dev/null 2>&1; then
    cwd="$(jq -r '.cwd // empty' <<<"$1" 2>/dev/null || true)"
  else
    cwd="$(sed -n 's/.*"cwd"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' <<<"$1" | head -n 1)"
  fi
  [[ -n "${cwd}" && -d "${cwd}" ]] || cwd="${PWD}"
  printf '%s\n' "${cwd}"
}

# cmd_hook <claude|agy> <start|stop>: each step runs as its own process so
# its errors stay fatal to it and are reported, never to the session.
cmd_hook() {
  local tool="${1:-}" event="${2:-}" self="${BASH_SOURCE[0]}" input cwd out notes=""
  case "${tool}:${event}" in
    claude:start | claude:stop | agy:start | agy:stop) ;;
    *)
      echo "Usage: agent-memory hook <claude|agy> <start|stop>" >&2
      exit 2
      ;;
  esac
  input="$(cat)"
  if [[ ! -d "${STORE}" ]]; then
    [[ "${tool}" == agy ]] && echo '{}'
    return 0
  fi
  cwd="$(hook_cwd "${input}")"

  if [[ "${event}" == stop ]]; then
    "${self}" sync --if-needed </dev/null >/dev/null 2>&1 || true
    [[ "${tool}" == agy ]] && echo '{}'
    return 0
  fi

  if ! out="$("${self}" sync </dev/null 2>&1)"; then
    notes+="agent-memory: sync failed, working from the local copy: ${out}"$'\n'
  fi
  if [[ "${tool}" == claude ]]; then
    if ! out="$("${self}" link "${cwd}" </dev/null 2>&1)"; then
      notes+="agent-memory: shared memory is not wired up for this project: ${out}"$'\n'
    fi
    "${self}" index </dev/null >/dev/null 2>&1 || true
    if ! out="$("${self}" check "${cwd}" </dev/null 2>&1)"; then
      notes+="agent-memory: memory files to fix:"$'\n'"${out}"$'\n'
    fi
    printf '%s' "${notes}"
    return 0
  fi

  out="$("${self}" context "${cwd}" </dev/null 2>&1)" || true
  if command -v jq >/dev/null 2>&1; then
    jq -n --arg m "${notes}${out}" '{injectSteps: [{systemMessage: {systemMessage: $m}}]}'
  else
    echo '{}'
  fi
}

main() {
  local cmd="${1:-}"
  [[ $# -gt 0 ]] && shift
  case "${cmd}" in
    key) cmd_key "$@" ;;
    paths) cmd_paths "$@" ;;
    link) cmd_link "$@" ;;
    index) cmd_index ;;
    check) cmd_check "$@" ;;
    context) cmd_context "$@" ;;
    sync) cmd_sync "$@" ;;
    hook) cmd_hook "$@" ;;
    -h | --help | help) sed -n '2,$ { /^#/!q; s/^# \{0,1\}//; p }' "${BASH_SOURCE[0]}" ;;
    *)
      echo "Usage: agent-memory key|paths|link|index|check|context|sync|hook ...  (--help for details)" >&2
      exit 2
      ;;
  esac
}

# Run only when executed directly, so the helpers can be sourced for testing.
if [[ "${BASH_SOURCE[0]}" == "${0}" ]]; then
  main "$@"
fi
