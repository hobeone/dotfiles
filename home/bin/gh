#!/bin/bash
set -euo pipefail

REAL_GH=""
if [ -x "$HOME/bin/gh.real" ]; then
    REAL_GH="$HOME/bin/gh.real"
else
    REAL_GH=$(type -a -p gh 2>/dev/null | grep -v "$HOME/bin/gh" | head -n 1 || true)
fi

if [ -z "$REAL_GH" ] || [ ! -x "$REAL_GH" ]; then
    if [ -x "/usr/bin/gh" ]; then
        REAL_GH="/usr/bin/gh"
    elif [ -x "/bin/gh" ]; then
        REAL_GH="/bin/gh"
    fi
fi


tmp_files=()
cleanup() {
    if [ "${#tmp_files[@]}" -gt 0 ]; then
        rm -f "${tmp_files[@]}"
    fi
}
trap cleanup EXIT

# Scrub KEY=value tokens from prose, but leave Markdown code alone: fenced
# blocks (``` or ~~~) and inline code spans (balanced backtick runs) are
# passed through verbatim so build commands like `GOARCH=386 go build` survive.
filter_text() {
    python3 -c '
import sys, re
KV = re.compile(r"\b[A-Z0-9_]+=\S+")
FENCE = re.compile(r"^\s{0,3}(`{3,}|~{3,})")
# A code span is a backtick run matched by an equal-length run (CommonMark).
SPAN = re.compile(r"(?<!`)(`+)(?!`)(.+?)(?<!`)\1(?!`)", re.S)

def scrub_prose(s):
    out, pos = [], 0
    for m in SPAN.finditer(s):
        out.append(KV.sub("", s[pos:m.start()]))
        out.append(m.group(0))
        pos = m.end()
    out.append(KV.sub("", s[pos:]))
    return "".join(out)

text = sys.stdin.read()
out, prose, fence = [], [], None
def flush():
    if prose:
        out.append(scrub_prose("".join(prose)))
        prose.clear()
for line in text.splitlines(keepends=True):
    m = FENCE.match(line)
    if fence is None and m:
        flush(); fence = m.group(1)[0]; out.append(line)
    elif fence is not None:
        out.append(line)
        if m and m.group(1)[0] == fence:
            fence = None
    else:
        prose.append(line)
flush()
sys.stdout.write("".join(out))
'
}

filter_title() {
    python3 -c '
import sys, re
text = sys.stdin.read()
text = re.sub(r"\b[A-Z0-9_]+=\S+", "", text)
text = " ".join(text.split())
sys.stdout.write(text)
'
}

args=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        -t|--title)
            if [ "$#" -ge 2 ]; then
                title="$2"
                clean_title=$(printf '%s\n' "$title" | filter_title)
                args+=("$1" "$clean_title")
                shift 2
            else
                args+=("$1")
                shift
            fi
            ;;
        -t=*|--title=*)
            flag="${1%%=*}"
            title="${1#*=}"
            clean_title=$(printf '%s\n' "$title" | filter_title)
            args+=("${flag}=${clean_title}")
            shift
            ;;
        -b|--body)
            if [ "$#" -ge 2 ]; then
                body="$2"
                clean_body=$(printf '%s\n' "$body" | filter_text)
                args+=("$1" "$clean_body")
                shift 2
            else
                args+=("$1")
                shift
            fi
            ;;
        -b=*|--body=*)
            flag="${1%%=*}"
            body="${1#*=}"
            clean_body=$(printf '%s\n' "$body" | filter_text)
            args+=("${flag}=${clean_body}")
            shift
            ;;
        -F|--body-file)
            if [ "$#" -ge 2 ]; then
                body_file="$2"
                if [ -f "$body_file" ]; then
                    tmp_body=$(mktemp)
                    tmp_files+=("$tmp_body")
                    filter_text < "$body_file" > "$tmp_body"
                    args+=("$1" "$tmp_body")
                else
                    args+=("$1" "$body_file")
                fi
                shift 2
            else
                args+=("$1")
                shift
            fi
            ;;
        -F=*|--body-file=*)
            flag="${1%%=*}"
            body_file="${1#*=}"
            if [ -f "$body_file" ]; then
                tmp_body=$(mktemp)
                tmp_files+=("$tmp_body")
                filter_text < "$body_file" > "$tmp_body"
                args+=("${flag}=${tmp_body}")
            else
                args+=("$1")
            fi
            shift
            ;;
        *)
            args+=("$1")
            shift
            ;;
    esac
done

if [ -n "${REAL_GH:-}" ] && [ -x "$REAL_GH" ]; then
    "$REAL_GH" "${args[@]}"
else
    echo "Error: Real gh CLI binary not found." >&2
    exit 1
fi
