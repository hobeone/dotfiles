#!/usr/bin/env bash
# Stub `agy` for agy-review.sh tests. `agy models` serves the fixture list;
# any other invocation (the review run itself) is logged to STUB_LOG, so a
# test can prove agy was, or was not, run.
#   STUB_LOG          file receiving one line per non-`models` invocation
#   STUB_MODELS_FAIL  non-empty -> `agy models` exits 1
if [[ ${1:-} == models ]]; then
	[[ -z ${STUB_MODELS_FAIL:-} ]] || exit 1
	cat "$(dirname "$0")/../resolve_model/models.tsv"
	exit 0
fi
echo "$*" >>"${STUB_LOG:?}"
echo "stub review output"
